{
  "name": "the-bodyguard",
  "version": "0.0.7",
  "description": "An opinionated microservice wrapper for rapid development based off OpenAPI documentation",
  "main": "bin/index.js",
  "bin": "bin/index.js",
  "scripts": {
    "build": "ts-node build.ts",
    "lint": "biome format .",
    "lint:fix": "biome format --write .",
    "cli": "ts-node source/index.ts",
    "start:petstore": "npm run cli -- --openapi tests/unit/petstore/petstore.yaml --output ./tmp/petstore-dev",
    "start:petstore:build": "npm run build && node bin/index.js --openapi tests/unit/petstore/petstore.yaml --output ./tmp/petstore-dev",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:safe": "jest",
    "test:coverage": "npm run test -- --coverage",
    "prepare": "husky",
    "release": "semantic-release",
    "install:examples": "npm run install:examples:azure-functions && npm run install:examples:express",
    "install:examples:azure-functions": " npm --prefix examples/azure-functions install --ignore-scripts",
    "install:examples:express": " npm --prefix examples/express install --ignore-scripts"
  },
  "author": "Damian Pokorski @damianpokorski",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@biomejs/biome": "2.0.0-beta.6",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-angular": "^19.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/cli-color": "^2.0.6",
    "@types/get-installed-path": "^4.0.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "get-installed-path": "^4.0.8",
    "globals": "^15.8.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@apideck/better-ajv-errors": "^0.3.6",
    "@stoplight/json-ref-resolver": "^3.1.6",
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.16.0",
    "ajv-formats": "^3.0.1",
    "cli-color": "^2.0.4",
    "commander": "^12.1.0",
    "esbuild": "^0.21.5",
    "js-yaml": "^4.1.0",
    "json-schema-to-typescript": "^15.0.0",
    "md5-file": "^5.0.0"
  }
}
