{
  "name": "the-bodyguard",
  "version": "0.0.7",
  "description": "An opinionated microservice wrapper for rapid development based off OpenAPI documentation",
  "main": "bin/index.js",
  "bin": "bin/index.js",
  "scripts": {
    "build": "tsx build.ts",
    "lint": "biome format .",
    "lint:fix": "biome format --write .",
    "cli": "tsx source/index.ts",
    "start:petstore": "npm run cli -- --openapi tests/unit/petstore/petstore.yaml --output ./tmp/petstore-dev",
    "start:petstore:build": "npm run build && node bin/index.js --openapi tests/unit/petstore/petstore.yaml --output ./tmp/petstore-dev",
    "test": "vitest -c vitest.config.mts run",
    "test:coverage": "npm run test -- --coverage",
    "prepare": "husky",
    "release": "semantic-release",
    "ci:examples": "npm run ci:examples:azure-functions && npm run ci:examples:express",
    "ci:examples:azure-functions": " npm --prefix examples/azure-functions ci",
    "ci:examples:express": " npm --prefix examples/express ci",
    "cleanup": "rm -rf tmp && rm -rf examples/express/.api && rm -rf examples/azure-functions/.api"
  },
  "author": "Damian Pokorski @damianpokorski",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=v22.2.0",
    "npm": ">=10.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.4",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-angular": "^19.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/cli-color": "^2.0.6",
    "@types/get-installed-path": "^4.0.3",
    "@types/node": "^20.14.2",
    "@vitest/coverage-v8": "^3.2.3",
    "get-installed-path": "^4.0.8",
    "globals": "^15.8.0",
    "husky": "^9.0.11",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@apideck/better-ajv-errors": "^0.3.6",
    "@stoplight/json-ref-resolver": "^3.1.6",
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.16.0",
    "ajv-formats": "^3.0.1",
    "cli-color": "^2.0.4",
    "commander": "^14.0.0",
    "esbuild": "^0.21.5",
    "js-yaml": "^4.1.0",
    "json-schema-to-typescript": "^15.0.0",
    "md5-file": "^5.0.0"
  }
}
