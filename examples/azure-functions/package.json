    "tsx": "^4.20.3",
    "typescript": "^5.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0"
  }
